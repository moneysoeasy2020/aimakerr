def send_telegram_alert(message: str):
    """发送 Telegram 警报推送"""
    if not TG_BOT_TOKEN or not TG_CHAT_ID:
        return
    url = f"https://api.telegram.org/bot{TG_BOT_TOKEN}/sendMessage"
    payload = {
        "chat_id": TG_CHAT_ID,
        "text": message,
        "parse_mode": "Markdown",
    }
    try:
        res = requests.post(url, json=payload, timeout=5)
        if res.status_code != 200:
            console.print(
                f"[dim red]Telegram 推送失败: {res.text}[/dim red]"
            )
    except Exception as e:
        console.print(f"[dim red]Telegram 请求异常: {e}[/dim red]")


class SmartFomoMonitor:

    def __init__(self):
        self.base_url = "https://api.fomoapi.io"
        self.headers = {
            "Accept": "application/json",
            "Authorization": f"Bearer {API_KEY}",
        }

    def get_top_traders(self) -> list:
        """获取收益率榜单 Top 交易员"""
        url = f"{self.base_url}/v2/leaderboard/24h"
        try:
            res = requests.get(url, headers=self.headers, timeout=10)
            if res.status_code == 200:
                data = res.json()
                traders = data if isinstance(data, list) else data.get("data", [])
                return traders[:TOP_N_TRADERS]
            else:
                console.print(
                    f"[bold red]获取 Leaderboard 失败，状态码: {res.status_code}[/bold red]"
                )
                return []
        except Exception as e:
            console.print(f"[bold red]拉取 Leaderboard 异常: {e}[/bold red]")
            return []

    def get_trader_positions(self, handle: str) -> list:
        """获取单个交易员符合金额门槛的持仓"""
        url = f"{self.base_url}/v2/users/{handle}/balances"
        try:
            res = requests.get(url, headers=self.headers, timeout=10)
            if res.status_code != 200:
                return []
            data = res.json()
            balances = (
                data.get("balances", []) if isinstance(data, dict) else data
            )

            valid_positions = []
            for item in balances:
                token_info = item.get("token", {})
                symbol = (
                    token_info.get("symbol")
                    if isinstance(token_info, dict)
                    else item.get("symbol")
                )
                value_usd = item.get("valueUsd", 0)

                if not symbol:
                    continue
                symbol = str(symbol).upper()

                # 聪明过滤：剔除黑名单币种与小额仓位
                if (
                    symbol not in SYMBOL_BLACKLIST
                    and value_usd >= MIN_POSITION_VALUE_USD
                ):
                    valid_positions.append(
                        {
                            "handle": handle,
                            "symbol": symbol,
                            "value_usd": value_usd,
                        }
                    )
            return valid_positions
        except Exception:
            return []

